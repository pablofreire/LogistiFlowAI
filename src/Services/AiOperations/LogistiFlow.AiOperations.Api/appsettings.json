{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Logging": {
    "Json": false
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": ""
  },
  "Jwt": {
    "Issuer": "logistiflow-gateway",
    "Audience": "logistiflow-api",
    "SigningKey": ""
  },
  "Services": {
    "Orders": "http://localhost:5101",
    "Inventory": "http://localhost:5102",
    "Fulfillment": "http://localhost:5103",
    "Shipping": "http://localhost:5104"
  },
  "AiProvider": {
    "Endpoint": null,
    "ApiKey": "",
    "Model": ""
  },
  "Copilot": {
    "MaxToolRounds": 6,
    "MaxOutputTokens": 800,
    "Timeout": "00:00:45",
    "HistoryTurns": 5,
    "ScanLimit": 100,
    "InputCostPerThousandTokensUsd": 0,
    "OutputCostPerThousandTokensUsd": 0
  }
}
