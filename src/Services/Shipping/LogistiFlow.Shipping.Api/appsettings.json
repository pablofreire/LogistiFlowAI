{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Logging": {
    "Json": false
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": ""
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "",
    "Password": ""
  },
  "Jwt": {
    "Issuer": "logistiflow-gateway",
    "Audience": "logistiflow-api",
    "SigningKey": ""
  },
  "CarrierApi": {
    "BaseAddress": "http://localhost:5190",
    "Timeout": "00:00:05"
  },
  "ShippingWorkers": {
    "TrackingPollInterval": "00:00:05"
  }
}
