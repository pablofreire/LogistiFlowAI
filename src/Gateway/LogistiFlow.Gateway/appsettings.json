{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning",
        "Yarp": "Warning"
      }
    }
  },
  "Logging": {
    "Json": false
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": ""
  },
  "Jwt": {
    "Issuer": "logistiflow-gateway",
    "Audience": "logistiflow-api",
    "SigningKey": "",
    "AccessTokenLifetime": "01:00:00"
  },
  "Services": {
    "Orders": "http://localhost:5101",
    "Inventory": "http://localhost:5102",
    "Fulfillment": "http://localhost:5103",
    "Shipping": "http://localhost:5104",
    "AiOperations": "http://localhost:5105"
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 10,
      "Window": "00:01:00"
    }
  }
}
