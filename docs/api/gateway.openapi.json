          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "ApiResponseOfAuthenticatedUser": {
        "required": [
          "success",
          "data",
          "error",
          "traceId"
        ],
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AuthenticatedUser"
              }
            ]
          },
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
