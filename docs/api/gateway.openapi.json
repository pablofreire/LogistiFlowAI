                "$ref": "#/components/schemas/JsonElement"
              }
            ]
          },
          "inventory": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JsonElement"
              }
            ]
          },
          "fulfillment": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JsonElement"
              }
            ]
          },
          "shipping": {
            "oneOf": [
