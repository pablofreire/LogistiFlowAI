          },
          "traceId": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "Envelope used by every REST endpoint so clients handle success and failure uniformly."
      },
      "AuthenticatedUser": {
        "required": [
          "id",
          "email",
          "displayName",
          "role"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "GetDashboardSummaryResponse": {
        "required": [
          "orders",
          "inventory",
          "fulfillment",
          "shipping",
          "unavailableSources",
          "generatedAt"
        ],
        "type": "object",
        "properties": {
          "orders": {
            "oneOf": [
              {
                "type": "null"
              },
