                "$ref": "#/components/schemas/ApiError"
              }
            ]
          },
          "traceId": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "Envelope used by every REST endpoint so clients handle success and failure uniformly."
      },
      "ApiResponseOfGetDashboardSummaryResponse": {
        "required": [
          "success",
          "data",
          "error",
          "traceId"
        ],
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/GetDashboardSummaryResponse"
              }
            ]
          },
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ApiError"
              }
            ]
          },
          "traceId": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "Envelope used by every REST endpoint so clients handle success and failure uniformly."
      },
      "ApiResponseOfLoginResponse": {
        "required": [
          "success",
          "data",
          "error",
          "traceId"
        ],
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LoginResponse"
              }
            ]
          },
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ApiError"
              }
            ]
          },
          "traceId": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "Envelope used by every REST endpoint so clients handle success and failure uniformly."
      },
      "ApiResponseOfObject": {
        "required": [
          "success",
          "data",
          "error",
          "traceId"
        ],
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {},
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ApiError"
              }
