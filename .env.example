# Copy to .env to override the local development defaults used by docker-compose.yml.
# Never commit .env. Every value below is for local use only.
POSTGRES_USER=logistiflow
POSTGRES_PASSWORD=change-me-postgres
RABBITMQ_USER=logistiflow
RABBITMQ_PASSWORD=change-me-rabbitmq
# HMAC key shared by the gateway (issuer) and the services (validators); at least 32 bytes.
JWT_SIGNING_KEY=change-me-to-a-random-value-of-at-least-32-bytes
# Password of the four seeded demo users (admin@, ops.manager@, warehouse.operator@, viewer@logistiflow.local).
DEMO_PASSWORD=change-me-demo-password
WEB_PORT=8088
GATEWAY_PORT=8089
POSTGRES_PORT=55450
RABBITMQ_PORT=5682
RABBITMQ_MANAGEMENT_PORT=15682
LOGIN_RATE_LIMIT=30

# Carrier simulator: one tracking step per interval; Shipping polls carriers this often.
CARRIER_STEP_INTERVAL=00:00:03
TRACKING_POLL_INTERVAL=00:00:02

# Operations copilot. Leave the key or the model empty to use the deterministic demo provider (labelled as simulated).
# For Azure AI Foundry use its OpenAI v1 endpoint, e.g. https://<resource>.openai.azure.com/openai/v1/
AI_PROVIDER_ENDPOINT=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
